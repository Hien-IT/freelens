{
  // Ignore mismatch for Biome version to make Renovate updates without error
  // trunk-ignore(biome/deserialize)
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              {
                "type": false
              },
              ":NODE:",
              ":BLANK_LINE:",
              "@freelensapp/**",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "css": {
    "formatter": {
      // Biome does not indent the continuation lines of a custom property
      // value, so a long one reads better on a single line.
      "lineWidth": 130
    },
    "parser": {
      // The core stylesheets use Tailwind v4 at-rules: @apply, @config,
      // @custom-variant and @reference.
      "tailwindDirectives": true
    }
  },
  "files": {
    // The Kubernetes manifests of the resource templates keep their sequences
    // unindented, which Biome cannot do, so yamlfmt formats them with the
    // .yamlfmt.yaml of their directory. pnpm writes its own lockfile and
    // workspace file, and Trunk rewrites its own .trunk/trunk.yaml on every
    // trunk upgrade. The Specify CLI of Spec Kit manages .specify/ and the
    // .claude/skills/speckit-* skills, records the digest of each skill it
    // writes, and refuses to upgrade over a changed one, so only the
    // constitution, which the project writes, is checked there. Biome does not
    // descend into an excluded directory, so its directory is re-included too.
    "includes": [
      "**",
      "!**/.specify/**",
      "**/.specify/memory",
      "**/.specify/memory/constitution.md",
      "!**/.claude/skills/speckit-*/**",
      "!**/.trunk/**",
      "!**/build/**",
      "!**/dist/**",
      "**/build/*.{js,cjs,mjs}",
      "!**/packages/resource-templates/templates/**",
      // The store fixtures shared with the Tauri build are the bytes the
      // Electron build writes, tabs and missing final newline included.
      "!**/freelens-tauri/src-tauri/tests/fixtures/data-dir/**",
      // The catalog fixtures hold invalid YAML, UTF-16 files and invalid
      // UTF-8 on purpose, and the catalogs the Electron build sends for them.
      "!**/freelens-tauri/src-tauri/tests/fixtures/catalog/**",
      "!**/pnpm-lock.yaml",
      "!**/pnpm-workspace.yaml"
    ]
  },
  "formatter": {
    "attributePosition": "auto",
    "bracketSpacing": true,
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
    "useEditorconfig": true
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "attributePosition": "auto",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "jsxRuntime": "reactClassic"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noRedundantRoles": "off"
      },
      "complexity": {
        // should be error later
        "noBannedTypes": "off",
        "noUselessConstructor": "off",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error"
      },
      "correctness": {
        "noInvalidUseBeforeDeclaration": "error",
        // should be error later
        "noUnusedVariables": "off",
        "useExhaustiveDependencies": "off"
      },
      "nursery": {
        // Markdown
        "useConsistentHeadingLevel": "error",
        "useFencedCodeLanguage": "error",
        "useSingleTopLevelHeading": "error"
      },
      "preset": "none",
      "style": {
        "noNamespace": "error",
        // should be error later
        "noParameterAssign": "off",
        "useArrayLiterals": "off",
        "useAsConstAssertion": "error",
        "useBlockStatements": "off",
        "useNamingConvention": {
          "level": "off",
          "options": {
            "strictCase": false
          }
        },
        "useNodejsImportProtocol": "error",
        // should be error later
        "useTemplate": "off"
      },
      "suspicious": {
        "noEmptyInterface": "off",
        // should be error later
        "noExplicitAny": "off",
        "noExtraNonNullAssertion": "error",
        "noMisleadingInstantiator": "error",
        // should be error later
        "noUnsafeDeclarationMerging": "off",
        "useNamespaceKeyword": "error"
      }
    }
  },
  "markdown": {
    "parser": {
      // The SKILL.md files of the agent skills start with YAML frontmatter,
      // which Biome otherwise reads as a thematic break and a setext heading.
      "frontmatter": true
    }
  },
  "overrides": [
    {
      // Test-only modules, kept out of production code. No tsconfig declares
      // the Vitest globals, so test code imports them from "vitest". The
      // testing helpers of React resolve from every program too, and they
      // build and pass the unit tests, but React leaves `act` out of its
      // production build, so they throw only in a packaged application. The
      // next override lifts the rule for tests and test support.
      "includes": ["**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "vitest": "Vitest is for test code only",
                  "react": {
                    "importNames": ["act"],
                    "message": "React.act is for test code only: the production build of React does not have it, so the call throws in a packaged application"
                  },
                  "react-dom/test-utils": "react-dom/test-utils is for test code only: its act delegates to React.act, which the production build of React does not have, so the call throws in a packaged application"
                },
                "patterns": [
                  {
                    "group": ["@testing-library/**"],
                    "message": "Testing Library is for test code only: the act of @testing-library/react delegates to React.act, which the production build of React does not have, so the call throws in a packaged application"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Tests and test support, which import their Vitest functions from
      // "vitest" explicitly, and the test-support packages built on Testing
      // Library.
      "includes": [
        "**/*.test.*",
        "**/*.tests.*",
        "**/__mocks__/**",
        "**/__test__/**",
        "**/__tests__/**",
        "**/test-utils/**",
        "**/getDiForUnitTesting*",
        "**/vitest*.setup.*",
        "**/mock-responses.ts",
        "**/features/cluster/execute/common/testing.ts",
        "**/vitest.electron-stub.ts",
        "**/packages/technical-features/messaging/messaging-fake-bridge/**",
        "**/packages/utility-features/react-testing-library-discovery/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      // The browser-side trees of the fixture extension, linted as the
      // extension migration guide recommends for any extension: a Node builtin
      // import belongs in the main entry point only.
      "includes": ["**/packages/fixture-extension/src/common/**", "**/packages/fixture-extension/src/renderer/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      // Renderer and common code of the application, classified by the path
      // rule of tsconfig.renderer.json: a Node builtin import belongs in main
      // code. Tests and test support are left out, as they are of that program.
      // See "Runtime Environments in Type-Checking" in AGENTS.md.
      "includes": [
        "**/freelens/src/**/renderer/**",
        "**/freelens/src/**/renderer-api/**",
        "**/freelens/src/**/common/**",
        "**/freelens/src/**/common-api/**",
        "**/packages/core/src/**/renderer/**",
        "**/packages/core/src/**/renderer-api/**",
        "**/packages/core/src/**/common/**",
        "**/packages/core/src/**/common-api/**",
        "!**/main/**",
        "!**/main-api/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__mocks__/**",
        "!**/__test__/**",
        "!**/__tests__/**",
        "!**/test-env/**",
        "!**/test-utils/**",
        "!**/*.global-override-for-injectable.ts",
        "!**/getDiForUnitTesting.ts",
        "!**/getDiForUnitTesting.tsx",
        "!**/packages/core/src/features/cluster/enumeration/common/test-utils.ts",
        "!**/packages/core/src/features/cluster/execute/common/testing.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "yaml": {
    "formatter": {
      // Flow sequences stay [a, b], as yamlfmt left them; the global
      // bracketSpacing is meant for JavaScript objects.
      "bracketSpacing": false
    }
  }
}
