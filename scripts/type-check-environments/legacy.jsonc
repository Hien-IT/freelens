// Legacy lists of the environment type-check programs (tsconfig.main.json and
// tsconfig.renderer.json), read by scripts/type-check-environments.mjs. See
// "Runtime Environments in Type-Checking" in AGENTS.md.
//
// Each list of a program holds the files of that program that failed its check
// when the programs were introduced. Their errors are tolerated there; the
// combined program, tsconfig.typecheck.json, which has both DOM and Node, still
// checks them in full.
//
// These lists may only shrink. Never add a file to make a new error pass:
// move the code to the environment that has the API, or write it with APIs
// both environments have. When a listed file stops failing, the check fails
// until the file is removed from its list.
{
  // Main or common files that need DOM.
  "main": [
    "packages/core/src/common/catalog-entities/web-link.ts",
    "packages/core/src/common/k8s-api/window-location.injectable.ts",
    "packages/core/src/common/utils/cluster-id-url-parsing.ts",
    "packages/core/src/extensions/extension-loader/extension-loader.ts"
  ],

  // Renderer or common files that need Node. The renderer runs without Node,
  // so the list stays empty, and the check refuses an entry on it.
  "renderer": []
}
